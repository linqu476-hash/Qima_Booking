# Password for the dashboard login (required)
DASH_PASSWORD=change-me
# Random string used to sign login cookies (optional but recommended)
SECRET_KEY=
# Public address of the dashboard, used in alert links (optional)
PUBLIC_URL=
# Set to 1 when the dashboard is served over HTTPS
COOKIE_SECURE=0
# Server time zone for the scheduler, e.g. Asia/Phnom_Penh
TZ=UTC
