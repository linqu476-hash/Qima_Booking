# Password for the dashboard login (required)
DASH_PASSWORD=change-me
# Random string used to sign login cookies (recommended): run `openssl rand -hex 32`
SECRET_KEY=
# Server time zone for the scheduler, e.g. Asia/Phnom_Penh
TZ=UTC

# --- HTTP only (testing): leave these as they are, open http://SERVER_IP:8000
BIND=0.0.0.0
COOKIE_SECURE=0
PUBLIC_URL=

# --- HTTPS (recommended): set a domain pointing at this server, then
#     BIND=127.0.0.1, COOKIE_SECURE=1, PUBLIC_URL=https://your-domain
DOMAIN=
