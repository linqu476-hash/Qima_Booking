# Copy these into the app's Secrets box on Streamlit Cloud (Advanced settings, Secrets).
# Never commit a real secrets.toml.
APP_PASSWORD = "choose-a-dashboard-password"
QIMA_USER = "your-qima-username"
QIMA_PASS = "your-qima-password"
# Optional: SUPPLIER_NAME = "..."   START_TIME = "..."   RUN_TIMEOUT_MIN = 45

